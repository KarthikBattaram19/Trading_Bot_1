{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volatility-trading.local/schemas/trading_parameters.schema.json",
  "title": "TradingParameters",
  "description": "Machine-readable trading parameter catalog derived from Docs/Trading_Parameters.md. Consumed by GET/POST /api/v1/config/strategy and option-chain pre-filters.",
  "type": "object",
  "required": [
    "version",
    "option_universe_filters"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema pointer used by editors / validators."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema catalog version; mirrors Docs/Trading_Parameters.md document version."
    },
    "source_document": {
      "type": "string",
      "const": "Docs/Trading_Parameters.md"
    },
    "option_universe_filters": {
      "$ref": "#/$defs/OptionUniverseFilters"
    },
    "oss_global_params": {
      "$ref": "#/$defs/OssGlobalParams"
    },
    "nfo_lot_sizing": {
      "$ref": "#/$defs/NfoLotSizing"
    },
    "oss_leg_params": {
      "$ref": "#/$defs/OssLegParams"
    },
    "market_data": {
      "$ref": "#/$defs/MarketDataParams"
    },
    "recommendation_universe_enrichment": {
      "$ref": "#/$defs/RecommendationUniverseEnrichment"
    },
    "quant_snapshot": {
      "type": "object",
      "additionalProperties": true
    },
    "strategy_coverage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "min_coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "min_eligible_symbols": {
          "type": "integer",
          "minimum": 0,
          "description": "Absolute eligible floor; keep ≤ recommendation_universe_enrichment.max_symbols so capped cycles can publish."
        },
        "abort_unavailable_strategies": { "type": "boolean" }
      }
    },
    "garch_forecast": {
      "$ref": "#/$defs/GarchForecastParams"
    },
    "iv_zscore": {
      "type": "object",
      "additionalProperties": true
    },
    "execution_constraints": {
      "$ref": "#/$defs/ExecutionConstraints"
    },
    "gamma_theta_breakeven": {
      "$ref": "#/$defs/GammaThetaBreakeven"
    },
    "strategies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "simple_volatility": {
          "$ref": "#/$defs/SimpleVolatilityStrategy"
        },
        "gamma_scalping": {
          "$ref": "#/$defs/GammaScalpingStrategy"
        },
        "vega_scalping": {
          "$ref": "#/$defs/VegaScalpingStrategy"
        }
      }
    },
    "portfolio": {
      "$ref": "#/$defs/PortfolioParams"
    },
    "pre_trade_gates": {
      "$ref": "#/$defs/PreTradeGates"
    },
    "kill_conditions": {
      "$ref": "#/$defs/KillConditions"
    }
  },
  "$defs": {
    "CurrencyCode": {
      "type": "string",
      "enum": ["INR", "USD"]
    },
    "Moneyness": {
      "type": "string",
      "enum": ["atm", "near_atm", "itm", "otm"]
    },
    "PremiumField": {
      "type": "string",
      "enum": ["mid", "ask", "bid"]
    },
    "AtmSelectionRule": {
      "type": "string",
      "enum": ["closest_strike_to_spot", "delta_closest_to_half"]
    },
    "OptionUniverseFilters": {
      "type": "object",
      "description": "Part T — hard filters applied before strategy signals.",
      "required": [
        "max_option_premium",
        "premium_currency",
        "premium_field",
        "moneyness",
        "atm_selection_rule",
        "atm_strike_tolerance",
        "underlying_price_currency",
        "min_volume",
        "min_open_interest",
        "max_spread_pct",
        "volume_vs_avg_min_ratio",
        "oi_vs_avg_min_ratio",
        "atm_history_lookback_days",
        "atm_history_min_days",
        "atm_liquidity_agg",
        "spread_agg",
        "high_liquidity_required"
      ],
      "additionalProperties": false,
      "properties": {
        "max_option_premium": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300,
          "description": "T1 — reject options with premium >= this value (INR)."
        },
        "premium_currency": {
          "$ref": "#/$defs/CurrencyCode",
          "description": "T2 — currency for premium comparisons."
        },
        "premium_field": {
          "$ref": "#/$defs/PremiumField",
          "description": "T3 — chain field used for pre-trade premium screen."
        },
        "premium_field_long": {
          "$ref": "#/$defs/PremiumField",
          "description": "T9 — conservative field for long legs (typically ask)."
        },
        "premium_field_short": {
          "$ref": "#/$defs/PremiumField",
          "description": "T9 — field for short legs (typically bid or mid)."
        },
        "moneyness": {
          "const": "atm",
          "description": "T5 — At the Money only; OTM/ITM substitutes rejected."
        },
        "atm_selection_rule": {
          "$ref": "#/$defs/AtmSelectionRule",
          "description": "T6 — strike selection algorithm."
        },
        "atm_strike_tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "T7 — zero tolerance; only the single closest strike qualifies."
        },
        "equidistant_strike_preference": {
          "type": "string",
          "enum": ["lower", "higher"],
          "description": "T8 — when two strikes are equidistant from spot."
        },
        "underlying_price_currency": {
          "$ref": "#/$defs/CurrencyCode",
          "description": "T12 — currency for underlying price comparisons."
        },
        "min_volume": {
          "type": "integer",
          "minimum": 1,
          "description": "T13 — absolute minimum daily ATM volume using min(CE, PE)."
        },
        "min_open_interest": {
          "type": "integer",
          "minimum": 1,
          "description": "T14 — absolute minimum ATM open interest using min(CE, PE)."
        },
        "max_spread_pct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "T15 — pass only if max(CE, PE) spread_pct is strictly less than this value."
        },
        "volume_vs_avg_min_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "T13b — current ATM volume must be > this × prior rolling average."
        },
        "oi_vs_avg_min_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "T14b — current ATM OI must be > this × prior rolling average."
        },
        "atm_history_lookback_days": {
          "type": "integer",
          "minimum": 1,
          "description": "Max prior sessions in ATM volume/OI average (typically 20)."
        },
        "atm_history_min_days": {
          "type": "integer",
          "minimum": 1,
          "description": "Min prior sessions before relative volume/OI gates can pass (typically 10)."
        },
        "chain_relative_min_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "§3.2 cold-start fallback (history_days < atm_history_min_days): current ATM volume/OI must be > this × the median of its same-session near-ATM peer strikes (backend/services/universe_enrichment.py NEAR_ATM_PEER_WINDOW)."
        },
        "atm_liquidity_agg": {
          "type": "string",
          "const": "min_ce_pe",
          "description": "Aggregate ATM volume/OI as min(CE, PE)."
        },
        "spread_agg": {
          "type": "string",
          "const": "max_ce_pe",
          "description": "Aggregate ATM spread as max(CE, PE) spread percent."
        },
        "high_liquidity_required": {
          "type": "boolean",
          "const": true,
          "description": "T16 — enforce absolute floors, relative volume/OI, and spread gates."
        },
        "applies_to_strategies": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["simple_volatility", "gamma_scalping", "vega_scalping"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "OssGlobalParams": {
      "type": "object",
      "description": "Part A — OSS global parameters (Area 1). India production must not copy the OSS US Y8 default of 100.",
      "additionalProperties": false,
      "properties": {
        "eval_date": { "type": "string", "format": "date" },
        "eval_time": { "type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}$" },
        "eval_datetime": { "type": "string", "format": "date-time" },
        "und_price": { "type": "number", "exclusiveMinimum": 0 },
        "underlying_symbol": { "type": "string", "minLength": 1 },
        "div_yield": { "type": "number", "minimum": 0 },
        "int_rate": { "type": "number", "minimum": 0 },
        "flat_volatility": { "type": "boolean" },
        "volatility": { "type": "number", "exclusiveMinimum": 0 },
        "display_mode": { "type": "string", "enum": ["per_share", "total"] },
        "default_contract_multiplier": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "OSS Y8 workbook / what-if only. India paper+live sizing sets null and uses nfo_lot_sizing."
        },
        "default_stock_multiplier": { "type": "integer", "minimum": 1 },
        "contract_multiplier_source": {
          "type": "string",
          "enum": ["nfo_instrument_lotsize", "oss_workbook_default"],
          "description": "A11 India rule: use ICICI Direct NFO lotsize per contract; never blindly apply OSS US 100."
        }
      }
    },
    "NfoLotSizing": {
      "type": "object",
      "description": "India NFO lot sizing — Part A11 / I10. Effective option multiplier = instrument-master lotsize for that contract.",
      "additionalProperties": false,
      "required": [
        "enabled",
        "resolve_from",
        "per_contract",
        "do_not_copy_oss_us_default"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "When true, bot sizes F&O with each symbol's real NFO lot."
        },
        "resolve_from": {
          "type": "string",
          "enum": ["icici_direct_instrument_master"],
          "description": "Authoritative lotsize source for paper and live."
        },
        "per_contract": {
          "type": "boolean",
          "description": "Resolve lotsize per resolved NFO contract (not a single global constant)."
        },
        "do_not_copy_oss_us_default": {
          "type": "boolean",
          "const": true,
          "description": "Hard rule: never apply OSS workbook Y8=100 to India NFO sizing."
        },
        "oss_us_workbook_default": {
          "type": "integer",
          "const": 100,
          "description": "Documented OSS US equity/ETF default — parity fixtures only."
        },
        "stock_leg_multiplier": {
          "type": "integer",
          "minimum": 1,
          "description": "Cash/stock hedge legs use multiplier 1 (shares)."
        },
        "quantity_must_be_multiple_of_lotsize": {
          "type": "boolean",
          "description": "Reject orders whose quantity is not an integer multiple of lotsize."
        },
        "min_lots": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum number of NFO lots (I10); share quantity = lots × lotsize."
        },
        "reference_equity_lots": {
          "type": "object",
          "description": "Offline/docs reference for equity NFO lots (spot ≤ ₹1000 when options+underlying). Live ICICI Direct lotsize always wins.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "reference_index_lots": {
          "type": "object",
          "description": "Reference index NFO lots for options-only mode (no underlying price cap). Live ICICI Direct lotsize always wins.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "OssLegParams": {
      "type": "object",
      "description": "Part B — OSS leg parameters.",
      "additionalProperties": false,
      "properties": {
        "leg_id": { "type": "integer", "minimum": 1 },
        "position": { "type": "integer" },
        "expiration_id": { "type": ["string", "integer"] },
        "days_to_expiry": { "type": "number", "minimum": 0 },
        "strike": { "type": "number", "exclusiveMinimum": 0 },
        "type": { "type": "string", "enum": ["none", "stock", "call", "put"] },
        "initial_price": { "type": "number", "minimum": 0 },
        "leg_volatility": { "type": "number", "exclusiveMinimum": 0 },
        "contract_multiplier": { "type": "integer", "minimum": 1 },
        "expiration_datetime": { "type": "string", "format": "date-time" }
      }
    },
    "MarketDataParams": {
      "type": "object",
      "description": "Part G — shared market data requirements.",
      "additionalProperties": false,
      "properties": {
        "price_history_required": { "type": "boolean" },
        "option_chain_required": { "type": "boolean" },
        "iv_required": { "type": "boolean" },
        "feed_stale_kill_seconds": { "type": "integer", "minimum": 1 },
        "option_chain_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "strike",
              "expiry",
              "expiration_datetime",
              "bid",
              "ask",
              "mid",
              "premium",
              "volume",
              "open_interest",
              "implied_volatility",
              "moneyness"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "RecommendationUniverseEnrichment": {
      "type": "object",
      "description": "Live NSE LTP + NFO GetOptionChain enrichment for every G11 underlying.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "cache_ttl_sec": { "type": "number", "minimum": 0 },
        "response_cache_ttl_sec": {
          "type": "number",
          "minimum": 0,
          "description": "TTL for the full RecommendationResponse cache used by /recommendations and /decisions."
        },
        "generation_budget_sec": {
          "type": "number",
          "minimum": 1,
          "description": "Wall-clock budget for live enrich + candle history so page APIs stay responsive."
        },
        "max_symbols": {
          "type": "integer",
          "minimum": 1,
          "description": "Cap how many FNO underlyings are live-enriched per cycle (priority names first)."
        },
        "max_concurrency": { "type": "integer", "minimum": 1 },
        "min_interval_ms": { "type": "number", "minimum": 0 },
        "fetch_spot_ltp": { "type": "boolean" },
        "prefer_dte_min": { "type": "integer", "minimum": 0 },
        "prefer_dte_max": { "type": "integer", "minimum": 0 }
      }
    },
    "GarchForecastParams": {
      "type": "object",
      "description": "Part H — GARCH(1,1) forecast weights.",
      "additionalProperties": false,
      "properties": {
        "gamma_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "alpha_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "beta_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "annualization_factor": { "type": "integer", "const": 252 },
        "block_when_distorted": { "type": "boolean" },
        "min_observations": { "type": "integer", "minimum": 1 },
        "max_log_return_gap": { "type": "number", "minimum": 0 },
        "enable_mle_fit": { "type": "boolean" },
        "fit_min_observations": { "type": "integer", "minimum": 20 }
      }
    },
    "ExecutionConstraints": {
      "type": "object",
      "description": "Part I — execution and retail constraints.",
      "additionalProperties": false,
      "properties": {
        "spread_cap_pct": { "type": "number", "minimum": 0 },
        "slippage_cap_pct": { "type": "number", "minimum": 0 },
        "commission_per_leg": { "type": "number", "minimum": 0 },
        "min_contract_size": {
          "type": "integer",
          "minimum": 1,
          "description": "I10 — minimum number of NFO lots (share qty = lots × instrument lotsize)."
        },
        "max_residual_delta": { "type": "number" },
        "max_residual_vega": { "type": "number" },
        "supervised_approval_required": { "type": "boolean" },
        "automation_allowed_post_fill": { "type": "boolean" },
        "multi_leg_sync_submit": { "type": "boolean" },
        "min_recommendation_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum post-learning confidence required to surface a recommendation (default 0.80)."
        }
      }
    },
    "GammaThetaBreakeven": {
      "type": "object",
      "description": "Part J — re-hedge parameters.",
      "additionalProperties": false,
      "properties": {
        "hedge_point_price": { "type": "number", "exclusiveMinimum": 0 },
        "gamma_theta_breakeven_pct": { "type": "number", "exclusiveMinimum": 0 },
        "use_half_breakeven": { "type": "boolean" },
        "rehedge_method": {
          "type": "string",
          "enum": ["increase_hedge", "reduce_options", "adjust_call_put_mix"]
        },
        "breakeven_paid_count": { "type": "integer", "minimum": 0 }
      }
    },
    "SimpleVolatilityStrategy": {
      "type": "object",
      "description": "Part L — Simple Volatility Trading.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "greek_targets": {
          "type": "object",
          "properties": {
            "delta": { "const": 0 },
            "gamma": { "type": "string", "const": "positive" },
            "vega": { "type": "string", "const": "positive" },
            "theta": { "type": "string", "const": "negative" }
          }
        },
        "option_selection": {
          "type": "object",
          "required": ["moneyness", "max_option_premium", "min_dte", "max_dte"],
          "properties": {
            "moneyness": { "const": "atm" },
            "max_option_premium": { "type": "number", "maximum": 300 },
            "premium_currency": { "$ref": "#/$defs/CurrencyCode" },
            "min_dte": { "type": "integer", "minimum": 0 },
            "max_dte": { "type": "integer", "minimum": 1 },
            "min_volume": { "type": "integer", "minimum": 0 },
            "min_open_interest": { "type": "integer", "minimum": 0 },
            "max_spread_pct": { "type": "number", "minimum": 0 }
          }
        },
        "entry_signal": {
          "type": "object",
          "properties": {
            "iv_below_garch_forecast": { "type": "boolean", "const": true }
          }
        },
        "hedge_method": {
          "const": "options_only"
        },
        "hold_horizon": {
          "type": "string",
          "enum": ["D+0", "D+1"]
        },
        "max_hold_days": { "type": "integer", "minimum": 0 }
      }
    },
    "GammaScalpingStrategy": {
      "type": "object",
      "description": "Part M — Gamma Scalping.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "gamma_entry_mode": {
          "type": "string",
          "enum": ["cheap_vol_mode", "earnings_gap_mode", "high_realized_vol_mode"]
        },
        "construction": {
          "const": "four_leg_options"
        },
        "option_selection": {
          "type": "object",
          "required": ["moneyness", "max_option_premium"],
          "properties": {
            "moneyness": { "const": "atm" },
            "max_option_premium": { "type": "number", "maximum": 300 },
            "premium_currency": { "$ref": "#/$defs/CurrencyCode" },
            "same_strike_near_far": { "type": "boolean", "const": true },
            "min_volume": { "type": "integer", "minimum": 1 },
            "min_open_interest": { "type": "integer", "minimum": 1 },
            "max_spread_pct": { "type": "number", "minimum": 0 }
          }
        },
        "vega_neutral_tolerance": { "type": "number", "minimum": 0 },
        "min_net_gamma": { "type": "number" },
        "calendar_construction": {
          "type": "object",
          "properties": {
            "long_expiry_min_gap_days": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "VegaScalpingStrategy": {
      "type": "object",
      "description": "Part N — Vega Scalping.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "hold_horizon": { "const": "intraday" },
        "vol_direction": { "const": "long" },
        "option_selection": {
          "type": "object",
          "required": ["moneyness", "max_option_premium"],
          "properties": {
            "moneyness": { "const": "atm" },
            "max_option_premium": { "type": "number", "maximum": 300 },
            "premium_currency": { "$ref": "#/$defs/CurrencyCode" },
            "min_dte": { "type": "integer", "minimum": 0 },
            "block_ultra_near_expiry": { "type": "boolean" },
            "min_volume": { "type": "integer", "minimum": 1 },
            "min_open_interest": { "type": "integer", "minimum": 1 },
            "max_spread_pct": { "type": "number", "minimum": 0 }
          }
        },
        "iv_signal": {
          "type": "object",
          "properties": {
            "entry_z_threshold": { "type": "number", "maximum": -2 },
            "short_vol_z_threshold": { "type": "number", "minimum": 2 },
            "stop_z_threshold": { "type": "number" },
            "stop_z_threshold_alt": { "type": "number" }
          }
        },
        "flatten_at_session_close": { "type": "boolean", "const": true },
        "hedge_method": { "const": "options_only" }
      }
    },
    "PortfolioParams": {
      "type": "object",
      "description": "Part O — portfolio-level limits.",
      "additionalProperties": false,
      "properties": {
        "hedge_reserve_pct": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_structure_pct": { "type": "number", "minimum": 0, "maximum": 1 },
        "post_shock_reduce": { "type": "boolean" }
      }
    },
    "PreTradeGates": {
      "type": "object",
      "description": "Part I21 — all must pass before submission.",
      "additionalProperties": false,
      "properties": {
        "signal_reproducible": { "type": "boolean" },
        "liquidity_ok": { "type": "boolean" },
        "size_rebalance_ok": { "type": "boolean" },
        "event_risk_reviewed": { "type": "boolean" },
        "regime_match": { "type": "boolean" },
        "cost_assumptions_valid": { "type": "boolean" },
        "exit_plan_defined": { "type": "boolean" },
        "option_premium_within_cap": { "type": "boolean" },
        "option_moneyness_atm": { "type": "boolean" },
        "underlying_price_within_cap": { "type": "boolean" }
      }
    },
    "KillConditions": {
      "type": "object",
      "description": "Part I22 — abort or flatten triggers.",
      "additionalProperties": false,
      "properties": {
        "kill_liquidity": { "type": "boolean" },
        "kill_hedge_unavailable": { "type": "boolean" },
        "kill_stale_data": { "type": "boolean" },
        "kill_event": { "type": "boolean" },
        "kill_neutrality": { "type": "boolean" },
        "kill_greek_limit": { "type": "boolean" },
        "kill_thesis": { "type": "boolean" }
      }
    }
  }
}
