# Backend env template — copy values into repo-root `.env`.
# Local: Docs/LOCAL_DEV.md (native Python + Node; no containers).
# Paper host: infra/env/railway.paper.env.example

# ICICI Direct Breeze (server-side only)
# Customer login: https://secure.icicidirect.com/customer/login
# Breeze app login: https://api.icicidirect.com/apiuser/login?api_key=<API_KEY>
# Docs: https://api.icicidirect.com/breezeapi/documents/index.html
ICICI_DIRECT_API_KEY=
ICICI_DIRECT_API_SECRET=
ICICI_DIRECT_SESSION_TOKEN=
ICICI_DIRECT_PUBLIC_IP=
# A2 WS Streaming 2.0 — same session_token; auto-connects after broker/test
# and when feeds/recommendations load. Manual: POST .../broker/ws/connect
# A3 shadow dry-run — POST .../broker/shadow-order (logs payloads; never place_order)
# Phase 1.10 Railway: infra/env/railway.paper.env.example (EXECUTION_MODE=paper)

EXECUTION_MODE=shadow
SUPERVISION_MODE=supervised
DEFAULT_BROKER=icici_direct
USE_ICICI_DIRECT_SHADOW=true
ALLOW_LIVE_PLACE_ORDER=false
PROCESS_ROLE=all
LOCAL_INFRA=none

# Empty = Phase 0 local without Postgres/Redis
DATABASE_URL=
REDIS_URL=
CHROMA_PERSIST_DIRECTORY=./data/chroma

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Market_News (§8.8) — optional; defaults to repo Market_News.txt + bundled fixture
# MARKET_NEWS_PATH=
# MARKET_NEWS_HEADLINES_PATH=
# MARKET_NEWS_STALE_SEC=1800
# MARKET_NEWS_CACHE_TTL_SEC=60

GROQ_API_KEY=
AUTH_ENABLED=false
JWT_SECRET_KEY=dev-only-change-in-production
