# Paper frontend — Vercel Environment Variables (Production + Preview).
# Build-time: NEXT_PUBLIC_* must be set before `next build`.

# Railway public HTTPS URL (no trailing slash), e.g. https://your-api.up.railway.app
NEXT_PUBLIC_API_URL=

# WebSocket URL for same host (wss://)
NEXT_PUBLIC_WS_URL=

# false once Railway API is reachable; true for UI-only mock demos
NEXT_PUBLIC_USE_MOCK_DATA=false
