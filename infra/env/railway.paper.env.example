# Paper backend — Railway variables (Phase 0: EXECUTION_MODE=shadow).
# Never set EXECUTION_MODE=live on Railway. ICICI Direct credentials are data-only.
# Image is built on Railway via Nixpacks (backend/nixpacks.toml + Procfile).
# No Dockerfile / Docker Desktop — Docs/LOCAL_DEV.md.

PORT=8000
PROCESS_ROLE=all
EXECUTION_MODE=shadow
SUPERVISION_MODE=supervised
DEFAULT_BROKER=icici_direct
USE_ICICI_DIRECT_SHADOW=true
ALLOW_LIVE_PLACE_ORDER=false

# From Railway Postgres / Redis plugins
DATABASE_URL=
REDIS_URL=

# Comma-separated Vercel URL(s), e.g. https://your-app.vercel.app
CORS_ORIGINS=

# ICICI Direct Breeze — marks / instrument master only (no place_order on paper)
# Customer login: https://secure.icicidirect.com/customer/login
# Breeze app login: https://api.icicidirect.com/apiuser/login?api_key=<API_KEY>
# Docs: https://api.icicidirect.com/breezeapi/documents/index.html
ICICI_DIRECT_API_KEY=
ICICI_DIRECT_API_SECRET=
ICICI_DIRECT_SESSION_TOKEN=
ICICI_DIRECT_PUBLIC_IP=

# Optional Track B
GROQ_API_KEY=
GROQ_MODEL=

AUTH_ENABLED=false
JWT_SECRET_KEY=
