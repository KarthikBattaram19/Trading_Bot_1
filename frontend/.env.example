# Frontend local / Vercel env template (paper stack).
# Production: set NEXT_PUBLIC_API_URL to the Railway HTTPS URL.
# Mock is opt-in: true = demo data; false (or unset + remote API) = live Railway.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_USE_MOCK_DATA=true
