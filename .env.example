# Local development (Windows-first) — native Python + Node only
# ================================================================
# Authority: Docs/LOCAL_DEV.md, Docs/architecture.md §18.2
#
# Phase 0–1 can run with Python + Node only. Postgres / Redis /
# Chroma HTTP are optional; paper_sim uses an in-process ledger.
# Hosted Postgres/Redis: Railway plugins (paper) or GCP (live).
# Remote builds: Railway Nixpacks / Google Cloud Buildpacks —
# no Docker Desktop, Podman, or Dockerfiles on this machine.

# ICICI Direct Breeze (server-side only — never expose to frontend)
# Customer login: https://secure.icicidirect.com/customer/login
# Breeze app login: https://api.icicidirect.com/apiuser/login?api_key=<API_KEY>
# Docs: https://api.icicidirect.com/breezeapi/documents/index.html
ICICI_DIRECT_API_KEY=
ICICI_DIRECT_API_SECRET=
ICICI_DIRECT_SESSION_TOKEN=
ICICI_DIRECT_PUBLIC_IP=

# Execution ramp: shadow (Phase 0 default) | paper | live (GCP only)
EXECUTION_MODE=shadow
SUPERVISION_MODE=supervised
DEFAULT_BROKER=icici_direct
USE_ICICI_DIRECT_SHADOW=true
# Phase 5 only — must stay unset/false on Railway paper stack
ALLOW_LIVE_PLACE_ORDER=false
PROCESS_ROLE=all

# Local data mode: none | native
#   none   = no local Postgres/Redis (Phase 0 default; paper_sim in-memory)
#   native = optional winget/installer Postgres + Redis on localhost
LOCAL_INFRA=none

# Leave empty for Phase 0 local (in-memory / no Redis). Set when using
# native installs or Railway plugin URLs.
DATABASE_URL=
REDIS_URL=

# Track B RAG: embedded Chroma on disk (no HTTP server / no containers)
CHROMA_PERSIST_DIRECTORY=./backend/data/chroma
# If you later run a native Chroma HTTP process, set host/port instead:
# CHROMA_HOST=localhost
# CHROMA_PORT=8100

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

GROQ_API_KEY=
GROQ_MODEL=

AUTH_ENABLED=false
JWT_SECRET_KEY=dev-only-change-in-production
